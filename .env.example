# Copiar a .env.local. Las variables NEXT_PUBLIC_* se incrustan al hacer `next build` (y son públicas).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Maps (sección 3.1 del plan de la fase 2). La clave de desarrollo debe estar restringida a
# http://localhost:3000/* y a Maps JavaScript API, Places API (New) y Geocoding API.
# Nunca subirla al repositorio. Sin clave, los mapas muestran un aviso y la app sigue funcionando.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Cúcuta
NEXT_PUBLIC_DEFAULT_MAP_CENTER=7.889100,-72.496700
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=13
# sur,oeste,norte,este; igual que SERVICE_AREA_BOUNDS del backend
NEXT_PUBLIC_SERVICE_AREA_BOUNDS=-4.3,-81.8,13.6,-66.8
